{
  "name": "terminal-restore",
  "displayName": "Terminal Restore",
  "description": "Automatically create named terminal tabs when you open a workspace. Configurable per-project via settings or a config file.",
  "version": "0.1.1",
  "publisher": "ervin-diaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ervin-d1az/terminal-restore.git"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "terminal",
    "restore",
    "tabs",
    "workspace",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminalRestore.restore",
        "title": "Terminal Restore: Create All Terminals"
      },
      {
        "command": "terminalRestore.closeAll",
        "title": "Terminal Restore: Close All Managed Terminals"
      }
    ],
    "configuration": {
      "title": "Terminal Restore",
      "properties": {
        "terminalRestore.terminals": {
          "type": "array",
          "default": [],
          "description": "List of terminals to create. Each item has a 'name' and optional 'command'.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Terminal tab name"
              },
              "command": {
                "type": "string",
                "description": "Optional command to run on terminal creation"
              },
              "icon": {
                "type": "string",
                "description": "Codicon name for the terminal tab icon (e.g. 'terminal-bash', 'rocket', 'hubot')"
              },
              "color": {
                "type": "string",
                "description": "Theme color for the terminal icon (e.g. 'terminal.ansiRed', 'terminal.ansiBlue', 'terminal.ansiGreen')"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "terminalRestore.autoRestore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore terminals when the workspace opens."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
